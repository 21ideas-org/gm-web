---
import Base from './Base.astro';
import { formatDate, formatRuDate } from '../lib/date';
import { newsArticleNode, breadcrumbNode } from '../lib/schema';
import { tagBySlug } from '../lib/tags';
import Subscribe from '../components/Subscribe.astro';
import Support from '../components/Support.astro';
import History from '../components/History.astro';

interface Props {
  id: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  prevPost?: { id: string; label: string };
  nextPost?: { id: string; label: string };
}
const { id, title, description, pubDate, tags = [], prevPost, nextPost } = Astro.props;
const chips = tags.map((s) => tagBySlug(s)).filter(Boolean);
const dateStr = formatDate(pubDate);
const dateLabel = formatRuDate(pubDate);
const pubIso = pubDate.toISOString();
const ogImage = new URL(`/og/${id}.png`, Astro.site).href;
const schema = [
  newsArticleNode({ title, description, slug: id, pubDate, image: ogImage }),
  breadcrumbNode([
    { name: 'Главная', path: '' },
    { name: 'Дайджесты', path: 'digests/' },
    { name: dateLabel, path: `digests/${id}/` },
  ]),
];
---
<Base
  title={`${title} — gm_₿`}
  description={description}
  path={`digests/${id}`}
  pathMeta="cat post.md"
  activeNav="digests"
  image={ogImage}
  ogType="article"
  publishedTime={pubIso}
  modifiedTime={pubIso}
  section="Биткоин"
  schema={schema}
>
  <nav class="breadcrumbs" aria-label="Хлебные крошки">
    <ol>
      <li><a href="/">главная</a></li>
      <li><a href="/digests">дайджесты</a></li>
      <li aria-current="page">{dateLabel}</li>
    </ol>
  </nav>

  <header class="post-header">
    <article class="prose">
      <h1>{title}</h1>
    </article>
    <div class="meta">
      <span class="date">{dateStr}</span>
    </div>
    {chips.length > 0 && (
      <nav class="tag-chips" aria-label="Темы выпуска" data-scroller>
        {chips.map((t) => <a href={`/tags/${t!.slug}`}>#{t!.label}</a>)}
      </nav>
    )}
  </header>

  <article class="prose">
    <slot />
  </article>

  <History pubDate={pubDate} />

  <Support text="На сегодня всё. Дайджест оказался полезным? Поддержи проект!" />

  <Subscribe text="Свежий дайджест каждое утро. Не пропусти следующий выпуск." />

  {(prevPost || nextPost) && (
    <nav class="post-nav" aria-label="Adjacent posts">
      {prevPost ? (
        <a href={`/digests/${prevPost.id}`} class="prev">
          <span class="label">← пред</span>
          <span class="title">{prevPost.label}</span>
        </a>
      ) : <div />}
      {nextPost ? (
        <a href={`/digests/${nextPost.id}`} class="next">
          <span class="label">след →</span>
          <span class="title">{nextPost.label}</span>
        </a>
      ) : <div />}
    </nav>
  )}
</Base>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    // Shareable headings: copy the deep link, reflect it in the address bar WITHOUT scroll-jumping
    // (replaceState, not location.hash — so it also doesn't fire :target on your own page), and
    // flash the hash glyph to a check. The whole <h2>/<h4> title is the tap target. Let modified
    // clicks (cmd/ctrl/shift/alt) fall through to native open-in-new-tab.
    const headLink = target.closest('.head-link');
    if (headLink instanceof HTMLAnchorElement &&
        !(event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)) {
      event.preventDefault();
      const id = headLink.getAttribute('href')?.slice(1) ?? '';
      const url = location.origin + location.pathname + '#' + id;
      const glyph = headLink.querySelector('.hgh');
      const original = glyph?.textContent ?? '';
      const restore = () => {
        headLink.removeAttribute('data-state');
        if (glyph) glyph.textContent = original;
      };
      navigator.clipboard
        .writeText(url)
        .then(() => {
          history.replaceState(null, '', '#' + id);
          headLink.dataset.state = 'copied';
          if (glyph) glyph.textContent = '✓';
          window.setTimeout(restore, 1500);
        })
        .catch(() => {
          headLink.dataset.state = 'error';
          if (glyph) glyph.textContent = '×';
          window.setTimeout(restore, 1500);
        });
      return;
    }

    const btn = target.closest('.code-copy');
    if (!(btn instanceof HTMLButtonElement)) return;
    const wrap = btn.closest('.code-wrap');
    const pre = wrap?.querySelector('pre');
    if (!pre) return;
    const text = pre.innerText;
    const restore = () => {
      btn.removeAttribute('data-state');
      btn.textContent = 'copy';
    };
    navigator.clipboard
      .writeText(text)
      .then(() => {
        btn.dataset.state = 'copied';
        btn.textContent = 'copied';
        window.setTimeout(restore, 1600);
      })
      .catch(() => {
        btn.dataset.state = 'error';
        btn.textContent = 'error';
        window.setTimeout(restore, 1600);
      });
  });
</script>
