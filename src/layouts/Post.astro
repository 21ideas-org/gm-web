---
import Base from './Base.astro';
import { formatEditionDate } from '../lib/date';
import { newsArticleNode, breadcrumbNode } from '../lib/schema';
import { tagBySlug } from '../lib/topics';
import { TOPICS_EN } from '../lib/topics-en';
import { EN_EDITION_PUBLIC, labels, localePath, type Locale } from '../lib/locale';
import Subscribe from '../components/Subscribe.astro';
import Support from '../components/Support.astro';
import History from '../components/History.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import { listeningState } from '../lib/listen-state';
import type { AudioEpisode } from '../lib/audio.mjs';

interface Props {
  locale?: Locale;
  id: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  audio?: AudioEpisode;
  prevPost?: { id: string; label: string };
  nextPost?: { id: string; label: string };
}
const { id, title, description, pubDate, tags = [], audio: suppliedAudio, prevPost, nextPost, locale = 'ru' } = Astro.props;
const t = labels[locale];
const audio = locale === 'ru' ? suppliedAudio : undefined;
const podcast = audio ? await listeningState() : undefined;
const chips = tags.map((s) => tagBySlug(s)).filter(Boolean);
const dateLabel = formatEditionDate(pubDate, locale);
const pubIso = pubDate.toISOString();
// Render only audio days here; split at the existing statistics heading so the complete
// Markdown introduction stays above the player without changing the published digest bytes.
const content = audio ? await Astro.slots.render('default') : '';
const statsStart = content.search(/<h2\b[^>]*\bid="статистика-сети"/u);
const introduction = statsStart >= 0 ? content.slice(0, statsStart) : '';
const body = statsStart >= 0 ? content.slice(statsStart) : content;
const ogImage = new URL(`/og/${locale === 'en' ? 'en/' : ''}${id}.png`, Astro.site).href;
const schema = [
  newsArticleNode({ title, description, slug: id, pubDate, image: ogImage, locale }),
  breadcrumbNode([
    { name: locale === 'en' ? 'Home' : 'Главная', path: locale === 'en' ? 'en/' : '' },
    { name: locale === 'en' ? 'Digests' : 'Дайджесты', path: locale === 'en' ? 'en/digests/' : 'digests/' },
    { name: dateLabel, path: `${locale === 'en' ? 'en/' : ''}digests/${id}/` },
  ]),
];
---
<Base
  locale={locale}
  title={`${title} — gm_₿`}
  description={description}
  path={`${locale === 'en' ? 'en/' : ''}digests/${id}`}
  pathMeta="cat post.md"
  activeNav="digests"
  image={ogImage}
  ogType="article"
  publishedTime={pubIso}
  modifiedTime={pubIso}
  section={locale === 'en' ? 'Bitcoin' : 'Биткоин'}
  schema={schema}
>
  <header class="post-header">
    <article class="prose">
      <h1>{title}</h1>
    </article>
    {chips.length > 0 && (
      <nav class="tag-chips" aria-label={t.topics} data-scroller>
        {chips.map((tag) => locale === 'en'
          ? <a href={`/en/tags/${tag!.slug}/`}>{TOPICS_EN[tag!.slug]}</a>
          : <a href={`/tags/${tag!.slug}`}>{tag!.label}</a>)}
      </nav>
    )}
  </header>

  {audio ? (
    <article id="audio-player">
      <div class="prose" set:html={introduction} />
      <AudioPlayer episode={audio} dateLabel={dateLabel} />
      {podcast?.ready && (
        <div class="podcast-subscribe">
          <a href="/listen/">Слушать в подкаст-приложении</a>
        </div>
      )}
      <div class="prose" set:html={body} />
    </article>
  ) : (
    <article class="prose">
      <slot />
    </article>
  )}

  <History pubDate={pubDate} locale={locale} />

  <Support locale={locale} text={t.postSupport} />

  {(locale === 'ru' || EN_EDITION_PUBLIC) && <Subscribe locale={locale} text={locale === 'en' ? "Follow us on Nostr for the next digest announcement, or subscribe to the full-text RSS feed." : "Свежий дайджест каждое утро. Не пропусти следующий выпуск."} />}

  {(prevPost || nextPost) && (
    <nav class="post-nav" aria-label={t.adjacent}>
      {prevPost ? (
        <a href={localePath(locale, `digests/${prevPost.id}/`)} class="prev">
          <span class="label">{t.prev}</span>
          <span class="title">{prevPost.label}</span>
        </a>
      ) : <div />}
      {nextPost ? (
        <a href={localePath(locale, `digests/${nextPost.id}/`)} class="next">
          <span class="label">{t.next}</span>
          <span class="title">{nextPost.label}</span>
        </a>
      ) : <div />}
    </nav>
  )}
</Base>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    // Shareable headings: copy the deep link, reflect it in the address bar WITHOUT scroll-jumping
    // (replaceState, not location.hash — so it also doesn't fire :target on your own page), and
    // flash the hash glyph to a check. The whole <h2>/<h4> title is the tap target. Let modified
    // clicks (cmd/ctrl/shift/alt) fall through to native open-in-new-tab.
    const headLink = target.closest('.head-link');
    if (headLink instanceof HTMLAnchorElement &&
        !(event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)) {
      event.preventDefault();
      const id = headLink.getAttribute('href')?.slice(1) ?? '';
      const url = location.origin + location.pathname + '#' + id;
      const glyph = headLink.querySelector('.hgh');
      const original = glyph?.textContent ?? '';
      const restore = () => {
        headLink.removeAttribute('data-state');
        if (glyph) glyph.textContent = original;
      };
      navigator.clipboard
        .writeText(url)
        .then(() => {
          history.replaceState(null, '', '#' + id);
          headLink.dataset.state = 'copied';
          if (glyph) glyph.textContent = '✓';
          window.setTimeout(restore, 1500);
        })
        .catch(() => {
          headLink.dataset.state = 'error';
          if (glyph) glyph.textContent = '×';
          window.setTimeout(restore, 1500);
        });
      return;
    }

    const btn = target.closest('.code-copy');
    if (!(btn instanceof HTMLButtonElement)) return;
    const wrap = btn.closest('.code-wrap');
    const pre = wrap?.querySelector('pre');
    if (!pre) return;
    const text = pre.innerText;
    const restore = () => {
      btn.removeAttribute('data-state');
      btn.textContent = 'copy';
    };
    navigator.clipboard
      .writeText(text)
      .then(() => {
        btn.dataset.state = 'copied';
        btn.textContent = 'copied';
        window.setTimeout(restore, 1600);
      })
      .catch(() => {
        btn.dataset.state = 'error';
        btn.textContent = 'error';
        window.setTimeout(restore, 1600);
      });
  });
</script>
