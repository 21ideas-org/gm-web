---
import Base from '../layouts/Base.astro';
import type { Locale } from '../lib/locale';
interface Props { locale?: Locale; }
const { locale = 'ru' } = Astro.props;
const en = locale === 'en';
const t = {
  title: en ? 'Support' : 'Поддержать', addresses: en ? 'donation addresses' : 'реквизиты',
  transparency: en ? 'transparency' : 'прозрачность', costs: en ? 'costs' : 'расходы', donations: en ? 'donations' : 'донаты',
  coverage: en ? 'coverage' : 'покрытие', allTime: en ? 'all time' : 'за всё время', balance: en ? 'balance' : 'баланс',
  month: en ? 'month' : 'месяц', sats: en ? 'sats' : 'саты', total: en ? 'TOTAL' : 'ИТОГО',
};
import CopyBlock from '../components/CopyBlock.astro';
import { getFinances } from '../lib/finances';
import { formatDate, formatEditionMonth } from '../lib/date';
import { SUPPORT_LN_ADDRESS, SUPPORT_BOLT12, SUPPORT_ONCHAIN } from '../consts';

const fin = getFinances();
const { current, months, totals, builtAt, lastDonationTs } = fin;

// ── display helpers (money stays as the numbers finances.ts computed; we only format) ──
const usd = (n: number): string => `$${n.toFixed(2)}`;
// Signed USD with a real minus sign (U+2212) for the NET / баланс figures.
const signedUsd = (n: number): string => `${n < 0 ? '−' : '+'}$${Math.abs(n).toFixed(2)}`;
// RU thousands grouping with a non-breaking space (U+00A0) so a sats figure never wraps mid-number.
const groupThousands = (n: number): string => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
const fmtSats = (n: number): string => `⚡ ${groupThousands(n)}`; // "⚡ 14 300"

// Coverage = donations / cost. Clamp the BAR WIDTH to 100% but print the true %. cost 0 ⇒ "—"
// (no divide-by-zero); the bar shows empty. `full` (>=100% covered) flips the fill from amber
// (--accent, "help needed") to green (--green, "covered").
type Cov = { width: string; label: string; full: boolean };
function coverage(don: number, cost: number): Cov {
  if (cost <= 0) return { width: '0%', label: '—', full: false };
  const pct = (don / cost) * 100;
  return { width: `${Math.min(100, pct)}%`, label: `${Math.round(pct)}%`, full: don >= cost };
}
const curCov = coverage(current.donationsUsd, current.costUsd);
const allCov = coverage(totals.donationsUsd, totals.costUsd);

const curMonthLabel = formatEditionMonth(new Date(`${current.month}-01T00:00:00Z`), locale);

// Pre-format the ledger rows here (pure TS) — keeps the template free of inline comparisons /
// block-body arrows that the .astro→TSX checker mis-parses as markup.
// Newest month first — the table grows downward over time, so most-recent-on-top reads best.
const ledgerRows = months.slice().reverse().map((m) => {
  const net = m.donationsUsd - m.costUsd;
  return {
    month: m.month,
    cost: usd(m.costUsd),
    donated: usd(m.donationsUsd),
    sats: groupThousands(m.donationsSats),
    net: signedUsd(net),
    netClass: net < 0 ? 'neg' : 'pos',
  };
});
const totalNetClass = totals.netUsd < 0 ? 'neg' : 'pos';
const balanceClass = totals.netUsd < 0 ? 'neg' : 'pos';
const showTotal = months.length > 1; // a one-month ledger's «ИТОГО» would just echo the single row

// Two honest, separate stamps (§5.5): page rebuild date vs last-donation recency. Divergence is
// expected during a donation lull and does NOT signal a stalled refresh — labels kept unambiguous.
const builtStamp = formatDate(new Date(builtAt));
const lastDonStamp = lastDonationTs ? formatDate(new Date(lastDonationTs)) : null;
const updatedLine = lastDonStamp
  ? `${en ? 'updated' : 'обновлено'} ${builtStamp} · ${en ? 'last donation' : 'последний донат'} ${lastDonStamp}`
  : `${en ? 'updated' : 'обновлено'} ${builtStamp}`;
---
<Base
  locale={locale}
  title={en ? 'support — gm_₿' : 'поддержать'}
  description={en ? 'Support GM, bitcoiner: Bitcoin donation addresses and the shared project report of costs, donations and monthly balance.' : 'Поддержать «Доброе утро, биткоинер»: реквизиты для донатов (Lightning, bolt12) и отчёты о финансировании проекта — расходы, донаты и баланс по месяцам.'}
  path={en ? 'en/support' : 'support'}
  pathMeta="cat support.md"
  activeNav="support"
>
  <section class="about-section">
    <h1 class="fin-h1">{t.title}</h1>
    <p>{en ? 'GM, bitcoiner is free for everyone. If you find the digest useful, a donation helps cover the servers and AI tokens needed to keep the project running.' : '«Доброе утро, биткоинер» — бесплатный проект для каждого. Если дайджест полезен — поддержите его донатом: это покрывает серверы и AI-токены, необходимые для продолжения работы проекта.'}</p>
  </section>

  <section class="about-section">
    <h2>{t.addresses}</h2>
    <div class="fin-wallet">
      <CopyBlock locale={locale} label="⚡ lightning address" value={SUPPORT_LN_ADDRESS} />
      {SUPPORT_BOLT12 && <CopyBlock locale={locale} label="⚡ bolt12" value={SUPPORT_BOLT12} />}
      {SUPPORT_ONCHAIN && <CopyBlock locale={locale} label="⛓ on-chain" value={SUPPORT_ONCHAIN} />}
    </div>
    <p>{en ? 'For on-chain donations and other Bitcoin payment options, visit the ' : 'Хочешь отправить саты ончейн или использовать другие биткоин-рельсы? Больше вариантов биткоин-платежей — на '}<a href="https://coinos.io/gmbitcoiner" rel="noopener">{en ? 'gmbitcoiner page' : 'страничке gmbitcoiner'}</a>.</p>
  </section>

  <section class="about-section">
    <h2>{t.transparency}</h2>
    <p>{en ? 'This is the shared financial report for the whole project, including both language editions. Costs are in dollars; donations are shown in satoshis and dollars at the rate on the day received. Detailed daily run reports are available ' : 'Ниже отображены реальные расходы и донаты проекта. Расходы — в долларах (так оплачиваются сервер и токены), донаты — в сатоши и в долларах по курсу на день получения. Подробные отчёты ежедневных запусков доступны '}<a href="https://github.com/21ideas-org/gm-web/tree/main/ops-reports/daily" rel="noopener">{en ? 'in the repository' : 'здесь'}</a>.</p>
    <p>{en ? 'The anonymised donation ledger is available ' : 'Реестр, хранящий анонимизированные данные о полученных донатах, хранится в открытом репозитории проекта '}<a href="https://github.com/21ideas-org/gm-web/tree/main/src/data" rel="noopener">{en ? 'in the public project repository' : 'здесь'}</a>. {en ? 'Donation records are refreshed semi-automatically.' : 'Информация о полученных донатах обновляется в полуавтоматическом режиме.'}</p>

    <div class="fin-coverage">
      <div class="fin-block">
        <div class="fin-block-title">{curMonthLabel}</div>
        <div class="fin-row"><span class="fin-label">{t.costs}</span><span class="fin-val">{usd(current.costUsd)}</span></div>
        <div class="fin-row"><span class="fin-label">{t.donations}</span><span class="fin-val">{usd(current.donationsUsd)} · {fmtSats(current.donationsSats)}</span></div>
        <div class="fin-row fin-row--bar">
          <span class="fin-label">{t.coverage}</span>
          <span class="fin-bar" aria-hidden="true"><span class:list={[{ full: curCov.full }]} style={`width:${curCov.width}`}></span></span>
          <span class="fin-pct">{curCov.label}</span>
        </div>
      </div>

      <div class="fin-block">
        <div class="fin-block-title">{t.allTime}</div>
        <div class="fin-row"><span class="fin-label">{t.costs}</span><span class="fin-val">{usd(totals.costUsd)}</span></div>
        <div class="fin-row"><span class="fin-label">{t.donations}</span><span class="fin-val">{usd(totals.donationsUsd)} · {fmtSats(totals.donationsSats)}</span></div>
        <div class="fin-row fin-row--bar">
          <span class="fin-label">{t.coverage}</span>
          <span class="fin-bar" aria-hidden="true"><span class:list={[{ full: allCov.full }]} style={`width:${allCov.width}`}></span></span>
          <span class="fin-pct">{allCov.label}</span>
        </div>
        <div class="fin-row"><span class="fin-label">{t.balance}</span><span class:list={["fin-val", "net", balanceClass]}>{signedUsd(totals.netUsd)}</span></div>
      </div>
    </div>

    <div class="fin-ledger-wrap">
      <table class="fin-ledger">
        <thead>
          <tr><th>{t.month}</th><th>{t.costs}</th><th>{t.donations}</th><th>{t.sats}</th><th>{t.balance}</th></tr>
        </thead>
        <tbody>
          {ledgerRows.map((r) => (
            <tr>
              <td>{r.month}</td>
              <td>{r.cost}</td>
              <td>{r.donated}</td>
              <td>{r.sats}</td>
              <td class:list={["net", r.netClass]}>{r.net}</td>
            </tr>
          ))}
        </tbody>
        {showTotal && (
          <tfoot>
            <tr>
              <td>{t.total}</td>
              <td>{usd(totals.costUsd)}</td>
              <td>{usd(totals.donationsUsd)}</td>
              <td>{groupThousands(totals.donationsSats)}</td>
              <td class:list={["net", totalNetClass]}>{signedUsd(totals.netUsd)}</td>
            </tr>
          </tfoot>
        )}
      </table>
    </div>

    <p class="fin-stamps">{updatedLine}</p>
  </section>

  {locale === 'ru' && (
  <section class="about-section" aria-labelledby="support-buy-bitcoin">
    <h2 id="support-buy-bitcoin">купить биткоин</h2>
    <p>21ideas давно пользуется услугами и сотрудничает с обменником Hermes. Обменивая биткоин или другую криптовалюту на доллар, евро, рубль или другую валюту, вы получаете лучшие условия и поддерживаете 21ideas. Подробности по клику ниже.</p>
    <div class="subscribe-actions">
      <a class="cta-btn cta-btn--accent" href="/buy-bitcoin/">купить биткоин <span class="arrow">→</span></a>
    </div>
  </section>
  )}
</Base>

<script>
  // Delegated copy handler for CopyBlock's `.code-copy` buttons. The /support page uses Base.astro
  // (not Post.astro), so it can't inherit Post.astro's handler — this is that same `.code-copy`
  // branch. A top-level sibling of the layout (mirrors Post.astro) so Astro hoists it as a script.
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const btn = target.closest('.code-copy');
    if (!(btn instanceof HTMLButtonElement)) return;
    const wrap = btn.closest('.code-wrap');
    const pre = wrap?.querySelector('pre');
    if (!pre) return;
    const text = pre.innerText;
    const restore = () => {
      btn.removeAttribute('data-state');
      btn.textContent = 'copy';
    };
    navigator.clipboard
      .writeText(text)
      .then(() => {
        btn.dataset.state = 'copied';
        btn.textContent = 'copied';
        window.setTimeout(restore, 1600);
      })
      .catch(() => {
        btn.dataset.state = 'error';
        btn.textContent = 'error';
        window.setTimeout(restore, 1600);
      });
  });
</script>
