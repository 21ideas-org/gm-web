---
import Base from '../layouts/Base.astro';
import { localePath, type Locale } from '../lib/locale';
interface Props { locale?: Locale; }
const { locale = 'ru' } = Astro.props;
const en = locale === 'en';
---
<Base
  locale={locale}
  noindex={en}
  title={en ? '404 — page not found' : '404 — страница не найдена'}
  description={en ? 'The page you requested could not be found.' : 'То, что вы искали, здесь не найдено.'}
  path={en ? 'en/404' : '404'}
  pathMeta={en ? 'Page not found' : 'Страница не найдена'}
>
  <Fragment slot="head">
    {!en && <script is:inline>
      // GitHub Pages has one static 404 document. EN errors use a built, noindex fallback page.
      // Forward only the pathname, never a request's query string; keep the fallback loop-safe.
      if ((location.pathname === '/en' || location.pathname.startsWith('/en/')) &&
          !/^\/en\/404\/?$/.test(location.pathname)) {
        location.replace('/en/404/?path=' + encodeURIComponent(location.pathname));
      }
    </script>}
  </Fragment>
  <section class="notfound" aria-labelledby="notfound-title">
    <header class="notfound-heading">
      <p class="notfound-code">404</p>
      <div>
        <p class="notfound-kicker">{en ? 'A note to our readers' : 'Сообщение читателю'}</p>
        <h1 id="notfound-title">{en ? 'Page not found' : 'Страница не найдена'}</h1>
      </div>
    </header>
    <p class="notfound-lead">{en ? 'The page you requested could not be found. It may have moved or never existed.' : 'По этому адресу нет страницы. Возможно, она переехала или в ссылке оказалась опечатка.'}</p>
    <p class="notfound-address"><span>{en ? 'Requested address' : 'Запрошенный адрес'}</span><span class="req-path">/</span></p>
    <nav aria-labelledby="notfound-links">
      <h2 id="notfound-links">{en ? 'Continue reading' : 'Продолжить чтение'}</h2>
      <ul class="bullet-list" role="list">
        <li><a href={localePath(locale)}>{en ? 'Latest issue' : 'Свежий выпуск'}</a></li>
        <li><a href={localePath(locale, 'digests/')}>{en ? 'Digest archive' : 'Архив дайджестов'}</a></li>
        <li><a href={localePath(locale, 'tags/')}>{en ? 'News by topic' : 'Новости по рубрикам'}</a></li>
        <li><a href={localePath(locale, 'projects/')}>{en ? '21ideas projects' : 'Проекты 21ideas'}</a></li>
        <li><a href={localePath(locale, 'about/')}>{en ? 'About the project' : 'О проекте'}</a></li>
      </ul>
    </nav>
  </section>
  <script is:inline data-error-locale={locale}>
    (function () {
      var p = location.pathname || '/';
      if (document.documentElement.lang === 'en') {
        p = new URLSearchParams(location.search).get('path') || p;
      }
      document.querySelectorAll('.req-path').forEach(function (el) { el.textContent = p; });
    })();
  </script>
</Base>
