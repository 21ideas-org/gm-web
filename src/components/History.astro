---
import { historyByDay, eventsForDay } from '../lib/history.mjs';
import { historyEventView } from '../lib/history-references.mjs';
import { formatMonthDay } from '../lib/date';

interface Props {
  pubDate: Date;
}
const { pubDate } = Astro.props;
// historyByDay() never rejects: an unavailable Calendar API resolves to {} and the section is omitted.
// Media stays in the event model but isn't rendered yet. References become source links below the
// description; invalid ones are dropped by historyEventView (an event with none renders as before).
// Paragraph splitting lives in the helper, not the template: an inline /\n{2,}/ regex literal trips
// the Astro compiler ({2,} reads as a JSX brace).
const events = eventsForDay(await historyByDay(), formatMonthDay(pubDate)).map(historyEventView);
---
{events.length > 0 && (
  <section class="history">
    <h2><span class="hgh" aria-hidden="true">##</span> Сегодня в истории</h2>
    {events.map((e) => (
      <details class="faq-item">
        <summary class="faq-q">{e.title}</summary>
        {e.paragraphs.map((p) => <p class="faq-a">{p}</p>)}
        {e.sources.length > 0 && (
          <ul class="history-sources">
            {e.sources.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
          </ul>
        )}
      </details>
    ))}
  </section>
)}
