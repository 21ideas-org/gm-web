---
// One wallet address rendered as a copyable code snippet. Emits the SAME toolbar markup the
// Markdown code-copy plugin produces (`.code-wrap > .code-toolbar(.code-lang + .code-copy) + pre`),
// but the inner <pre> uses `class="code-block"` so it borrows the bg/border from
// `.prose pre, pre.code-block` (global.css) WITHOUT being inside `.prose`. The copy handler is a
// delegated `.code-copy` listener; on a `Base`-layout page (e.g. /support) the page must include
// that listener itself (Post.astro's lives only there). See §5.2 of plans/donations.hardened.md.
interface Props {
  label: string; // rail name shown in the toolbar, e.g. "⚡ lightning"
  value: string; // the address / offer string
}
const { label, value } = Astro.props;
---
<div class="code-wrap">
  <div class="code-toolbar">
    <span class="code-lang">{label}</span>
    <button type="button" class="code-copy" aria-label="Скопировать">copy</button>
  </div>
  <pre class="code-block"><code>{value}</code></pre>
</div>
