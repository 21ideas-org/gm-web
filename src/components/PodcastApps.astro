---
import type { PodcastApp } from '../lib/podcast-apps.mjs';
import LightningBadge from './LightningBadge.astro';
interface Props { apps: PodcastApp[]; compact?: boolean; bullets?: boolean; idPrefix?: string; }
const { apps, compact = false, bullets = false, idPrefix = 'podcast-apps' } = Astro.props;
---
{apps.length > 0 && (
  <section class:list={["podcast-apps", { section: !compact && !bullets, 'podcast-apps--compact': compact, 'podcast-apps--bullets': bullets }]} aria-label="Слушать в приложении">
    {bullets ? <p class="podcast-platform-lead">Слушать на популярных подкаст-платформах:</p> : !compact && <div class="section-header"><h2>слушать в приложении</h2></div>}
    <ul class:list={{ 'bullet-list': bullets }} role="list">{apps.map((app) => <li>
      <a href={app.url} rel="noopener"><span>{app.name}{app.description && <small>{app.description}</small>}</span></a>
      {app.lightning && <LightningBadge id={`${idPrefix}-${app.id}-lightning`} />}
    </li>)}</ul>
  </section>
)}
