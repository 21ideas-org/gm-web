---
import { EN_EDITION_PUBLIC, labels, localePath, type Locale } from '../lib/locale';
interface Props { locale?: Locale; }
const { locale = 'ru' } = Astro.props;
---
<footer class="footer">
  <div class="left">gm_₿ <span aria-hidden="true">•</span> <a href="https://21ideas.org" rel="noopener">by 21ideas</a></div>
  <div class="right">
    <a class="footer-icon" href={localePath(locale, 'support/')} aria-label={labels[locale].support} title={labels[locale].support}>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="m13 2-9 12h7l-1 8 10-12h-7l1-8Z" />
      </svg>
    </a>
    <a class="footer-icon" href="https://github.com/21ideas-org/gm-web" rel="noopener" aria-label="GitHub" title="GitHub">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
        <path d="M12 .297C5.37.297 0 5.67 0 12.297c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.011-1.04-.017-2.04-3.338.724-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.085 1.838 1.237 1.838 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.305-5.467-1.334-5.467-5.93 0-1.31.469-2.381 1.236-3.221-.124-.303-.536-1.524.117-3.176 0 0 1.008-.322 3.301 1.23a11.52 11.52 0 0 1 3.003-.404c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.655 1.652.243 2.873.12 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.621-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.015 2.899-.015 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.594 24 12.297c0-6.627-5.373-12-12-12" />
      </svg>
    </a>
    {locale === 'ru' && <a class="footer-icon" href="https://t.me/bitcoin21ideas" rel="noopener" aria-label="Telegram" title="Telegram">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
        <path d="M22.8 3.2c.3-1.2-.5-1.7-1.3-1.4L1.8 9.4c-1.3.5-1.3 1.2-.3 1.5l5.1 1.6L18.4 5c.6-.4 1.2-.2.7.2l-9.6 8.7-.4 5.2c.6 0 .9-.3 1.3-.6l2.5-2.4 5.2 3.8c1 .5 1.6.3 1.9-.9z" />
      </svg>
    </a>}
    {(locale === 'ru' || EN_EDITION_PUBLIC) && <a class="footer-icon" href={localePath(locale, 'rss.xml')} aria-label="RSS" title="RSS">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false">
        <circle cx="5" cy="19" r="1.7" fill="currentColor" stroke="none" />
        <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" />
      </svg>
    </a>}
  </div>
</footer>
