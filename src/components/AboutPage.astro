---
import Base from '../layouts/Base.astro';
import ShortWordmark from './ShortWordmark.astro';
import type { Locale } from '../lib/locale';
interface Props { locale?: Locale; }
const { locale = 'ru' } = Astro.props;
import { faqPageNode } from '../lib/schema';

// Single source for the visible FAQ and the FAQPage JSON-LD (Google requires the two to match).
// Strictly informational — no buy/invest language (legal-safety + Google News/Yandex feed rules).
const faqsRu = [
  {
    q: 'Что такое «Доброе утро, биткоинер»?',
    a: 'Это ежедневный новостной дайджест на русском языке, посвящённый исключительно Биткоину. Каждое утро выходит краткая сводка главных событий сети Биткоин за последние сутки со ссылками на первоисточники: цена и рынок, майнинг, Lightning и другие решения второго слоя, разработка, регулирование, институционалы, безопасность. Каждый пункт сопровождается ссылкой на первоисточник, а в начале выпуска — блок статистики сети. Проект некоммерческий и входит в образовательную экосистему 21ideas.',
  },
  {
    q: 'Дайджест освещает криптовалюты?',
    a: '«Доброе утро, биткоинер» — это биткоин-онли дайджест. Дайджест не освещает альткоины, ICO и трейдинг-сигналы — лишь значимые новости, влияющие на сеть Биткоин: разработку протокола, майнинг, Lightning и другие решения второго слоя, регулирование и институциональное принятие. Щиткоины освещаются лишь с целью предостережения или в особо курьёзных случаях.',
  },
  {
    q: 'Как часто выходят выпуски и где их читать?',
    a: 'Выпуски выходят ежедневно, по утрам. Читать можно на <a href="https://gm.21ideas.org/">сайте</a>, получать в Telegram-канале <a href="https://t.me/bitcoin21ideas" rel="noopener">21ideas</a> или подписаться на <a href="https://gm.21ideas.org/rss.xml">RSS-ленту</a> с полным текстом выпусков.',
  },
  {
    q: 'Это бесплатно?',
    a: 'Да, доступ к дайджесту «Доброе утро, биткоинер» открыт для каждого. Проект некоммерческий, без платных подписок; материалы носят исключительно информационный характер и не являются инвестиционной рекомендацией. Сайт <a href="https://github.com/21ideas-org/gm-web" rel="noopener">открыт</a> под лицензией MIT.',
  },
];
const faqsEn = [
  {
    q: 'What does the digest cover?',
    a: 'Bitcoin news: protocol development, mining, Lightning, security, regulation, adoption and the people building around it. Each issue brings the key developments together in one concise read.',
  },
  {
    q: 'Where can I check the details?',
    a: 'News items link to their original sources. Follow those links for the full reports, data and announcements behind the summary.',
  },
  {
    q: 'How can I browse older stories?',
    a: 'Choose a month in the <a href="/en/digests/">archive</a> to browse past issues, or use <a href="/en/tags/">topics</a> to follow a subject across different days.',
  },
  {
    q: 'Is the digest free?',
    a: 'Yes. Every issue is freely available, without a paid subscription. Reader donations help keep the project running; you can find the details on the <a href="/en/support/">support page</a>.',
  },
];
const faqs = locale === 'en' ? faqsEn : faqsRu;
---
<Base
  locale={locale}
  title={locale === 'en' ? 'about gm_₿' : 'о gm_₿'}
  description={locale === 'en' ? 'About GM, bitcoiner, the daily Bitcoin-only digest with links to original sources.' : '«Доброе утро, биткоинер» — ежедневный биткоин-онли новостной дайджест на русском: что это, как устроены выпуски и как за ними следить.'}
  path={locale === 'en' ? 'en/about' : 'about'}
  pathMeta="cat about.md"
  activeNav="about"
  schema={faqPageNode(faqs)}
>
  {locale === 'ru' ? <>
  <section class="about-section">
    <div class="section-header"><h1>о проекте</h1></div>
    <p><strong>«Доброе утро, биткоинер»</strong> (<ShortWordmark />) — ежедневный биткоин-онли новостной дайджест на русском языке. Каждое утро — короткая сводка главных событий сети Биткоин за минувшие сутки. Только биткоин, только сигнал — никакого шума и никаких щиткоинов. Некоммерческий проект входит в экосистему 21ideas.</p>

    <article class="project-card" style="margin-top:8px">
      <div class="head">
        <span class="name">кратко</span>
      </div>
      <ul class="bullet-list links" role="list">
        <li><span class="k">язык</span>&nbsp; русский</li>
        <li><span class="k">тематика</span>&nbsp; только биткоин, никаких щиткоинов</li>
        <li><span class="k">периодичность</span>&nbsp; каждое утро</li>
        <li><span class="k">формат</span>&nbsp; статистика сети, сводка новостей + исторические события</li>
        <li><span class="k">с</span>&nbsp; июня 2026 года</li>
        <li><span class="k">лицензия</span>&nbsp; MIT</li>
      </ul>
    </article>
  </section>

  <section class="about-section">
    <h2>как это работает</h2>
    <p>Выпуски собираются автоматически: бот отбирает значимые новости из утверждённых источников, прикладывает исторические события дня из базы данных Биткоин-календаря, формирует дайджест и публикует его сюда, а затем анонсирует свежий выпуск в Telegram. Дайджесты и <a href="https://github.com/21ideas-org/gm-web/tree/main/ops-reports" rel="noopener">отчёты</a> ежедневных публикаций оцениваются и используются для корректировки автоматизации и улучшения будущих выпусков. Материалы носят исключительно информационный характер и не являются инвестиционной рекомендацией.</p>
  </section>

  <section class="about-section">
    <h2>как следить</h2>
    <article class="project-card" style="margin-top:8px">
      <div class="head">
        <span class="name">подписаться</span>
        <span class="status-label live">LIVE</span>
      </div>
      <ul class="bullet-list links" role="list">
        <li><a href="https://t.me/bitcoin21ideas" rel="noopener"><span class="k">telegram</span> t.me/bitcoin21ideas</a></li>
        <li><a href="/rss.xml"><span class="k">rss</span> /rss.xml</a></li>
      </ul>
    </article>
  </section>

  <section class="about-section">
    <h2>поддержать</h2>
    <p>Проект «Доброе утро, биткоинер» некоммерческий, и его работа напрямую зависит от вашей поддержки. Реквизиты для донатов и отчёты о финансировании проекта – на странице <a href="/support">поддержать</a>.</p>
  </section>

  <section class="about-section">
    <h2>часть экосистемы 21ideas</h2>
    <p>«Доброе утро, биткоинер» — часть образовательного биткоин-онли проекта <a href="https://21ideas.org" rel="noopener">21ideas</a>. Другие проекты экосистемы можно посмотреть на странице <a href="/projects">проекты</a>.</p>
  </section>

  <section class="about-section">
    <h2>частые вопросы</h2>
    {faqs.map((f) => (
      <details class="faq-item">
        <summary class="faq-q">{f.q}</summary>
        <p class="faq-a" set:html={f.a}></p>
      </details>
    ))}
  </section>
  </> : <>
    <section class="about-section">
      <div class="section-header"><h1>about</h1></div>
      <p><strong>GM, bitcoiner</strong> (<ShortWordmark />) is a daily Bitcoin-only news digest. Each edition brings a concise summary of recent developments with links to original sources: mining, Lightning, technology, regulation, institutions, security and the Bitcoin community.</p>
    </section>
    <section class="about-section">
      <h2>How it works</h2>
      <p>An automated editorial pipeline selects significant stories from approved sources and prepares a digest. Original source links accompany the stories so you can explore the details.</p>
      <p>Materials are provided for information and are not investment advice. Access is free, without a paid subscription. The <a href="https://github.com/21ideas-org/gm-web" rel="noopener">website source</a> is available under the MIT licence.</p>
    </section>
    <section class="about-section">
      <h2>Support the project</h2>
      <p>Reader donations help cover the project's servers and editorial tools. Donation addresses and the shared financial report are on the <a href="/en/support/">support page</a>.</p>
    </section>
    <section class="about-section">
      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (
        <details class="faq-item">
          <summary class="faq-q">{f.q}</summary>
          <p class="faq-a" set:html={f.a}></p>
        </details>
      ))}
    </section>
  </>}
</Base>
