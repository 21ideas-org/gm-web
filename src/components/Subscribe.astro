---
import { localePath, type Locale } from '../lib/locale';
import { listeningState } from '../lib/listen-state';
// Subscribe CTA — Telegram + RSS, with an optional section heading.
// Home renders the heading; digests pass no `heading`
// (the `subscribe--bare` variant adds a top separator instead).
interface Props {
  locale?: Locale;
  heading?: string;
  text: string;
  audioAction?: boolean;
}
const { heading, text, audioAction = false, locale = 'ru' } = Astro.props;
const showAudio = locale === 'ru' && audioAction && (await listeningState()).ready;
const TELEGRAM = 'https://t.me/bitcoin21ideas';
---
<section class:list={["subscribe", { "subscribe--bare": !heading }]} aria-label={locale === 'en' ? 'Subscribe to the English digest' : 'Подписка на дайджест'}>
  {heading && (
    <div class="section-header">
      <h2>{heading}</h2>
    </div>
  )}
  <p class="subscribe-lead">{text}</p>
  <div class="subscribe-actions">
    {locale === 'ru' && <a class="cta-btn" href={TELEGRAM} rel="noopener">telegram</a>}
    <a class="cta-btn" href={localePath(locale, 'rss.xml')}>rss</a>
    {showAudio && <a class="cta-btn" href="/listen/">аудио</a>}
  </div>
</section>
