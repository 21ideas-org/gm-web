---
import { publishedDigests } from '../lib/digests';
import { EN_EDITION_PUBLIC, type Locale } from '../lib/locale';
import { languageDestination } from '../lib/editions.mjs';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const visible = locale === 'en' || EN_EDITION_PUBLIC;
const destination = visible ? languageDestination(locale, Astro.url.pathname, await publishedDigests(locale === 'en' ? 'ru' : 'en')) : undefined;
---
{destination && <a class="language-switch" href={destination.href} hreflang={destination.locale} aria-label={destination.label} title={destination.label}>
  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-world" aria-hidden="true" focusable="false">
    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
    <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" />
    <path d="M3.6 9h16.8" />
    <path d="M3.6 15h16.8" />
    <path d="M11.5 3a17 17 0 0 0 0 18" />
    <path d="M12.5 3a17 17 0 0 1 0 18" />
  </svg>
</a>}
