---
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'projects'>['data'];
const { name, description, status, stack, url, repo } = Astro.props;

const statusClass = status.toLowerCase();
const links = [
  ...(url ? [{ k: 'ссылка', href: url }] : []),
  ...(repo ? [{ k: 'repo', href: repo }] : []),
];
---
<article class="project-card">
  <div class="head">
    <span class="name">{name}</span>
    <span class={`tag-bracket ${statusClass}`}>[{status}]</span>
  </div>
  {description && <p class="desc">{description}</p>}
  {stack && stack.length > 0 && (
    <div class="stack"><span class="k">стек:</span> <span class="v">{stack.join(', ')}</span></div>
  )}
  {links.length > 0 && (
    <div class="links">
      {links.map((link, i) => (
        <div>
          <span class="branch">{i === links.length - 1 ? '└──' : '├──'}</span>{' '}
          <span class="k">{link.k}</span>{' '}
          <a href={link.href} rel="noopener">{link.href.replace(/^https?:\/\//, '')}</a>
        </div>
      ))}
    </div>
  )}
</article>
