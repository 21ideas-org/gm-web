---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../lib/locale';

type Props = CollectionEntry<'projects'>['data'] & { locale?: Locale };
const { name, description, stack, url, telegram, repo, org, locale = 'ru' } = Astro.props;

const links = [
  ...(url ? [{ k: locale === 'en' ? 'website' : 'ссылка', href: url }] : []),
  ...(telegram ? [{ k: 'telegram', href: telegram }] : []),
  ...(repo ? [{ k: 'repo', href: repo }] : []),
  ...(org ? [{ k: 'org', href: org }] : []),
];
---
<article class="project-card">
  <div class="head">
    <span class="name">{name}</span>
  </div>
  {description && <p class="desc">{description}</p>}
  {stack && stack.length > 0 && (
    <div class="stack"><span class="k">{locale === 'en' ? 'stack:' : 'стек:'}</span> <span class="v">{stack.join(', ')}</span></div>
  )}
  {links.length > 0 && (
    <ul class="bullet-list links" role="list">
      {links.map((link) => (
        <li>
          <a href={link.href} rel="noopener"><span class="k">{link.k}</span>{' '}{link.href.replace(/^https?:\/\//, '')}</a>
        </li>
      ))}
    </ul>
  )}
</article>
