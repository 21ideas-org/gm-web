---
import Base from '../layouts/Base.astro';
import { publishedDigests } from '../lib/digests';
import { localizedProjects } from '../lib/projects';
import { EN_EDITION_PUBLIC, labels, localePath, type Locale } from '../lib/locale';

import { digestStatistics } from '../lib/digest-statistics.mjs';
import { formatEditionDate, formatIssueDate } from '../lib/date';
import { audioForDigest } from '../lib/audio.mjs';
import NetworkStats from './NetworkStats.astro';
import PostCard from '../components/PostCard.astro';
import Subscribe from '../components/Subscribe.astro';
import Support from '../components/Support.astro';
interface Props { locale?: Locale; }
const { locale = 'ru' } = Astro.props;
const t = labels[locale];
const buildDate = new Date().toISOString().slice(0, 10);

const posts = (await publishedDigests(locale)).slice(0, 3);
const latest = posts[0];
const statistics = digestStatistics(latest?.body, locale);
const block = statistics.find(item => item.key === 'block')?.value.replace('#', '');
const audio = locale === 'ru' && latest ? audioForDigest(latest.id) : undefined;
const latestHref = latest ? localePath(locale, `digests/${latest.id}/`) : localePath(locale, 'digests/');

const featured = (await localizedProjects(locale)).filter(project => project.data.featured);
---
<Base
  locale={locale}
  title={locale === 'en' ? 'GM, bitcoiner — daily Bitcoin digest in English' : 'Доброе утро, биткоинер — ежедневный биткоин-дайджест на русском'}
  description={locale === 'en' ? 'A daily Bitcoin-only news digest with links to original sources. Mining, Lightning, technology, regulation and adoption.' : 'Доброе утро, биткоинер. Каждый день — короткая сводка главных биткоин-новостей на русском: сеть, майнинг, Lightning, регулирование, институционалы. Только биткоин, только сигнал — без шума и щиткоинов.'}
  path={locale === 'en' ? 'en/site' : 'site'}
  pathMeta={`${locale === 'en' ? 'last build' : 'последняя сборка'}: ${buildDate}`}
  activeNav="home"
>
  {latest && <section class="front-page" aria-labelledby="fresh-edition">
    <div class:list={['front-page-grid', { 'front-page-grid--single-column': statistics.length === 0 }]}>
      <article class="front-lead front-digest">
        <div class="front-section-heading">
          <p class="front-category">{locale === 'en' ? 'Fresh issue' : 'Свежий выпуск'}</p>
          {block && <span class="edition-block">{locale === 'en' ? 'Block' : 'Блок'} {block}</span>}
        </div>
        <h2 id="fresh-edition"><time datetime={latest.data.pubDate.toISOString()}>{formatIssueDate(latest.data.pubDate, locale)}</time></h2>
        <div class="front-copy"><p>{latest.data.description}</p></div>
        <div class="front-actions">
          <a class="cta-btn cta-btn--accent" href={latestHref}>{locale === 'en' ? 'Read' : 'Читать'}</a>
          {audio && <a class="cta-btn" href={latestHref + '#audio-player'}>Слушать</a>}
        </div>
      </article>
      {statistics.length > 0 && <aside class="front-sidebar">
        <NetworkStats statistics={statistics} date={formatEditionDate(latest.data.pubDate, locale)} locale={locale} />
      </aside>}
    </div>
  </section>}

  {locale === 'ru' && (
  <Subscribe
    heading="подписаться"
    audioAction
    text="Хочешь получать ежедневную сводку биткоин-новостей?"
  />

  )}

  {locale === 'en' && EN_EDITION_PUBLIC && <Subscribe locale="en" heading="subscribe" text="Get the daily English digest in your feed reader." />}

  <section class="section" aria-labelledby="recent">
    <div class="section-header">
      <h2 id="recent">{t.recent}</h2>
      <a class="more" href={localePath(locale, 'digests/')}>{t.all}</a>
    </div>
    {posts.length === 0 && <p class="subscribe-lead">{t.empty}</p>}
    <ul class="post-list">
      {posts.map(post => (
        <li>
          <PostCard
            locale={locale}
            href={localePath(locale, `digests/${post.id}/`)}
            date={post.data.pubDate}
            description={post.data.description}
          />
        </li>
      ))}
    </ul>
  </section>

  <section class="section" aria-labelledby="featured">
    <div class="section-header">
      <h2 id="featured">{t.projects}</h2>
      <a class="more" href={localePath(locale, 'projects/')}>{locale === 'en' ? 'all projects' : 'все проекты'}</a>
    </div>
    <div class="featured-list">
      {featured.map(p => (
        <a class="featured-card" href={p.data.url ?? p.data.repo ?? p.data.org ?? localePath(locale, 'projects/')} rel="noopener">
          <span>
            <span class="name">{p.data.name}</span>
            <p class="desc">{p.data.description}</p>
          </span>
        </a>
      ))}
    </div>
  </section>

  <Support locale={locale} text={locale === 'en' ? 'GM, bitcoiner is a non-commercial project. Help keep the daily digest running.' : 'Ежедневный дайджест «Доброе утро, биткоинер» — некоммерческий проект. Не забудь поддержать его разработку!'} />

  {locale === 'ru' && (
  <section class="section" aria-labelledby="buy-bitcoin-heading">
    <div class="section-header">
      <h2 id="buy-bitcoin-heading">купить биткоин</h2>
    </div>
    <p class="subscribe-lead">Для обмена фиата на биткоин я пользуюсь услугами Hermes Exchange. Нужно обменять биткоин или другую криптовалюту на доллар, евро, рубль или другую валюту? Подробности по клику ниже.</p>
    <div class="subscribe-actions">
      <a class="cta-btn cta-btn--accent" href="/buy-bitcoin/">купить биткоин</a>
    </div>
  </section>
  )}
</Base>
