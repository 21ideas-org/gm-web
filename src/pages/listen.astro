---
import Base from '../layouts/Base.astro';
import ListenEpisode from '../components/ListenEpisode.astro';
import PodcastFeed from '../components/PodcastFeed.astro';
import { listeningState } from '../lib/listen-state';
const state = await listeningState();
---
<Base title="Слушать — Доброе утро, биткоинер" description="Аудиоверсия ежедневного биткоин-дайджеста на русском. Слушай на сайте или подпишись в любимом приложении." path="listen" activeNav="listen">
  <header class="listen-intro">
    <h1 class="fin-h1">Доброе утро, биткоинер — слушать</h1>
    <p class="subscribe-lead">Ежедневный биткоин-дайджест на русском. Слушай здесь или подпишись в любимом приложении.</p>
  </header>
  {state.ready && <PodcastFeed url={state.feedUrl!} />}
  {state.episodes.length > 0 ? (
    <div class="listen-episodes">
      {state.episodes.map(({ post, audio }) => <ListenEpisode post={post} audio={audio!} apps={state.apps} />)}
    </div>
  ) : (
    <section class="section" aria-label="Аудиовыпуски">
      <p class="subscribe-lead">Аудиовыпуски пока недоступны. Свежие новости можно прочитать в дайджестах.</p>
      <a class="cta-btn" href="/digests/">Читать дайджесты <span class="arrow">→</span></a>
    </section>
  )}
  <p class="listen-support"><a href="/support/">Поддержать создание дайджеста →</a></p>
</Base>
