---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { TAGS, tagBySlug, buildTagIndex, type NewsRef } from '../../lib/tags';

export async function getStaticPaths() {
  const index = await buildTagIndex();
  return TAGS.map((t) => ({
    params: { tag: t.slug },
    props: { items: (index.get(t.slug) ?? []) as NewsRef[] },
  }));
}

const { tag } = Astro.params;
const { items } = Astro.props as { items: NewsRef[] };
const def = tagBySlug(tag!)!;
---
<Base
  title={`${def.hubTitle} — gm_₿`}
  description={def.hubDesc}
  path={`tags/${def.slug}`}
  pathMeta={`grep -rl '#${def.slug}' digests/`}
  activeNav="tags"
>
  <section class="section">
    <div class="section-header"><h1>{def.hubTitle}</h1><span class="more">{items.length}</span></div>
    <p class="hub-desc">{def.hubDesc}</p>

    {items.length === 0 ? (
      <p class="hub-empty">Пока нет новостей по этой теме.</p>
    ) : (
      <ul class="post-list">
        {items.map((it) => (
          <li>
            <PostCard href={`/digests/${it.digestId}/#${it.anchor}`} date={it.date} title={it.ru_title} />
          </li>
        ))}
      </ul>
    )}

    <p class="other-tags">
      другие темы:
      {TAGS.filter((t) => t.slug !== def.slug).map((t) => (
        <a href={`/tags/${t.slug}`}>#{t.label}</a>
      ))}
    </p>
  </section>
</Base>
