---
import Base from '../../layouts/Base.astro';
import { TAGS, tagItemCounts } from '../../lib/tags';

const counts = await tagItemCounts();
const rows = TAGS.map((t) => ({ ...t, count: counts.get(t.slug) ?? 0 }))
  .filter((r) => r.count > 0)
  .sort((a, b) => b.count - a.count);
const max = rows.length ? Math.max(...rows.map((r) => r.count)) : 1;
---
<Base title="топики — gm_₿" description="Биткоин-новости по темам." path="tags" pathMeta="ls tags/" activeNav="tags">
  <section class="section">
    <div class="section-header"><h2>топики</h2><span class="more">{rows.length}</span></div>
    <ul class="tag-index">
      {rows.map((r) => (
        <li>
          <a class="tag-row" href={`/tags/${r.slug}`}>
            <span class="name"><span class="hash">#</span>{r.label}</span>
            <span class="count"><span class="bar" style={`width:${Math.round((r.count / max) * 80)}px`}></span>{r.count}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
