---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { formatRuDayMonth } from '../../lib/date';

export async function getStaticPaths() {
  const posts = (await getCollection('digests', p => !p.data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  const navLabel = (p: CollectionEntry<'digests'>) => ({ id: p.id, label: formatRuDayMonth(p.data.pubDate) });

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: posts[i + 1] ? navLabel(posts[i + 1]) : undefined,
      nextPost: posts[i - 1] ? navLabel(posts[i - 1]) : undefined,
    },
  }));
}

interface Props {
  post: CollectionEntry<'digests'>;
  prevPost?: { id: string; label: string };
  nextPost?: { id: string; label: string };
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
---
<Post
  id={post.id}
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  tags={post.data.tags}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <Content />
</Post>
